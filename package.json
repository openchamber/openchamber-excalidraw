{
  "name": "openchamber-excalidraw",
  "version": "1.0.0",
  "description": "Draw in .excalidraw and Obsidian .excalidraw.md files right in OpenChamber's Files view",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "excalidraw",
        "name": "Excalidraw",
        "icon": "icon.svg"
      },
      "fileEditors": [
        {
          "id": "canvas",
          "title": "Excalidraw",
          "match": ["*.excalidraw", "*.excalidraw.md"],
          "entry": "editor/index.html"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "lz-string": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.0.4",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.2"
  }
}
